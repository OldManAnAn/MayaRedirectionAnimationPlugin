{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "发送当前脚本到 Maya",
            "type": "process",
            "command": "D:/Maya2023/bin/mayapy.exe",
            "args": [
                "${workspaceFolder}/run_to_maya.py",
                "${file}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
